#!/bin/bash
# One entry point for the real rig. ./rig help lists the tasks (scripts/real/rig.py).
cd "$(dirname "$0")" || exit 1
if [ ! -x .venv/bin/python ]; then
  echo "no .venv here: python3.12 -m venv .venv && .venv/bin/pip install -r requirements.txt"; exit 1
fi
exec .venv/bin/python scripts/real/rig.py "$@"
